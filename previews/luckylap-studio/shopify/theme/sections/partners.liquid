<section class="partner-section section-pad" id="partners" aria-labelledby="PartnersTitle-{{ section.id }}"><p class="eyebrow">{{ 'partners.eyebrow' | t }}</p><h2 id="PartnersTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'partners.title' | t }}{% endif %}</h2><p class="partner-intro">{% if section.settings.text != blank %}{{ section.settings.text | escape }}{% else %}{{ 'partners.text' | t }}{% endif %}</p><div class="partner-grid">{% for block in section.blocks %}<article class="partner-card" {{ block.shopify_attributes }}><span class="partner-number">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</article>{% endfor %}</div>{% if section.settings.button_link != blank %}<a class="btn btn-light" href="{{ section.settings.button_link }}">{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'partners.action' | t }}{% endif %}<span aria-hidden="true">↗</span></a>{% endif %}</section>
{% schema %}
{
  "name": "Club, eventi e negozi",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Introduzione"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Pagina contatto"
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Club, eventi e negozi"
    }
  ],
  "blocks": [
    {
      "type": "opportunity",
      "name": "Opportunità",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testo"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo collegamento"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collegamento"
        }
      ]
    }
  ]
}
{% endschema %}
