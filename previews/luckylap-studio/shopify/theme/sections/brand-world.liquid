<section class="world-section" aria-labelledby="WorldTitle-{{ section.id }}"><div class="world-grid"><div><h2 id="WorldTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'world.title' | t }}{% endif %}</h2><p>{% if section.settings.text != blank %}{{ section.settings.text | escape }}{% else %}{{ 'world.text' | t }}{% endif %}</p>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ 'world.action' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}{% else %}<img src="{{ 'founders.webp' | asset_url }}" width="1200" height="960" loading="lazy" alt="{{ 'world.image_alt' | t }}">{% endif %}</div></section>
{% schema %}
{
  "name": "Il mondo LuckyLap",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fotografia"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Pagina del brand"
    }
  ]
}
{% endschema %}
