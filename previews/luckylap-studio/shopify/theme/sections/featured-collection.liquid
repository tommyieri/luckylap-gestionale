{% assign featured_collection = section.settings.collection | default: collections.all %}
<section class="collection-section" id="shop" data-filter-section aria-labelledby="FeaturedTitle-{{ section.id }}"><div class="section-heading"><div><p class="eyebrow">{{ 'home.collection_eyebrow' | t }}</p><h2 id="FeaturedTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'home.collection_title' | t }}{% endif %}</h2></div><a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ 'home.all_products' | t }} <span aria-hidden="true">↗</span></a></div>{% if section.settings.show_filters %}<div class="filter-tabs" aria-label="{{ 'collection.filter' | t }}"><button type="button" data-product-filter="all" aria-pressed="true">{{ 'collection.all' | t }}</button><button type="button" data-product-filter="tshirts" aria-pressed="false">{{ 'collection.tshirts' | t }}</button><button type="button" data-product-filter="caps" aria-pressed="false">{{ 'collection.caps' | t }}</button></div>{% endif %}<div class="shop-grid">{% for card_product in featured_collection.products limit: section.settings.products_to_show %}{% render 'product-card', card_product: card_product %}{% else %}<p class="empty-state">{{ 'collection.empty' | t }}</p>{% endfor %}</div></section>
{% schema %}
{
  "name": "Collezione in evidenza",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Prodotti",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Filtri T-shirt e cappellini",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collezione in evidenza"
    }
  ]
}
{% endschema %}
