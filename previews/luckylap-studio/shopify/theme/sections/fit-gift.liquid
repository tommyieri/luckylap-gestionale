{% liquid
  assign guide_product = section.settings.product
  assign guide_url = routes.all_products_collection_url
  if guide_product != blank
    assign guide_url = guide_product.url | append: '#taglie'
  endif
%}
<section class="fit-gift" aria-labelledby="FitGiftTitle-{{ section.id }}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 800px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
  {% else %}
    <img src="{{ 'hero.webp' | asset_url }}" alt="{{ 'fit_gift.image_alt' | t }}" width="1066" height="1600" loading="lazy">
  {% endif %}
  <div>
    <h2 id="FitGiftTitle-{{ section.id }}">{{ 'fit_gift.heading_first' | t }}<br>{{ 'fit_gift.heading_second' | t }}</h2>
    <p>{{ 'fit_gift.text' | t }}</p>
    <a class="btn btn-primary" href="{{ guide_url }}">{{ 'fit_gift.size_action' | t }} <span aria-hidden="true">↗</span></a>
    {% if section.settings.contact_link != blank %}<p class="fit-stockist">{{ 'fit_gift.stockist_text' | t }}<br><a class="text-link" href="{{ section.settings.contact_link }}">{{ 'fit_gift.stockist_action' | t }} <span aria-hidden="true">↗</span></a></p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Indossato e taglie",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fotografia indossata" },
    { "type": "product", "id": "product", "label": "Prodotto con guida taglie" },
    { "type": "url", "id": "contact_link", "label": "Informazioni sul punto vendita a Milano" }
  ],
  "presets": [{ "name": "Indossato e taglie" }]
}
{% endschema %}
