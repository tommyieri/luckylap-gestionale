{% liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'ProductForm-' | append: section.id
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign main_image_alt = main_image.alt | default: product.title
%}
<section class="product-page section-pad" data-product-section="{{ section.id }}" data-default-image="{{ product.featured_image | image_url: width: 1500 }}" data-default-image-alt="{{ product.featured_image.alt | default: product.title | escape }}">
  <div class="product-layout"><div class="product-gallery"><div class="product-main-image">{% if main_image %}{{ main_image | image_url: width: 1500 | image_tag: widths: '480, 750, 1000, 1500', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: main_image_alt, data-product-image: '' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>{% unless product.has_only_default_variant %}<p class="gallery-notice" data-variant-image-notice{% if current_variant.featured_image %} hidden{% endif %}>{{ 'product.image_notice' | t }}</p>{% endunless %}{% if product.images.size > 1 %}<div class="product-thumbnails">{% for image in product.images %}<a href="{{ image | image_url: width: 1500 }}" data-gallery-image data-image-src="{{ image | image_url: width: 1500 }}" data-image-alt="{{ image.alt | default: product.title | escape }}" aria-label="{{ 'product.image_number' | t: number: forloop.index, title: product.title | escape }}">{{ image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '90px', loading: 'lazy', alt: product.title }}</a>{% endfor %}</div>{% endif %}{% for media in product.media %}{% unless media.media_type == 'image' %}<div class="product-extra-media">{{ media | media_tag: image_size: '1000x', controls: true, preload: 'none' }}</div>{% endunless %}{% endfor %}</div>
  <div class="product-summary"><a class="text-link back-link" href="{{ routes.all_products_collection_url }}"><span aria-hidden="true">←</span> {{ 'product.back' | t }}</a>{% if section.settings.show_type and product.type != blank %}<p class="eyebrow">{{ product.type | escape }}</p>{% endif %}<h1>{{ product.title | escape }}</h1><p class="product-price" aria-live="polite" data-product-price>{{ current_variant.price | money }}</p><p class="product-stock" aria-live="polite" data-product-stock tabindex="-1" data-available-label="{{ 'product.available' | t }}">{% if current_variant.available %}{{ 'product.available' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</p>
    {% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: section.id %}
      {{ form.errors | default_errors }}
      <div class="native-variant-picker"><label for="VariantSelect-{{ section.id }}">{{ 'product.variant' | t }}</label><select name="id" id="VariantSelect-{{ section.id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %} data-options="{{ variant.options | json | escape }}" data-available="{{ variant.available }}" data-price="{{ variant.price | money | escape }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1500 }}" data-image-alt="{{ variant.featured_image.alt | default: product.title | escape }}"{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>
      {% unless product.has_only_default_variant %}<div class="enhanced-variant-picker" hidden>{% for option in product.options_with_values %}<fieldset class="option-group" data-option-index="{{ forloop.index0 }}"><legend>{{ option.name | escape }}</legend><div class="option-values">{% for option_value in option.values %}{% assign option_name = option_value.name | default: option_value %}<button type="button" class="option-value{% if option_value.selected %} is-selected{% endif %}" data-option-value="{{ option_name | escape }}" aria-pressed="{% if option_value.selected %}true{% else %}false{% endif %}">{{ option_name | escape }}</button>{% endfor %}</div></fieldset>{% endfor %}</div>{% endunless %}
      <label class="quantity-label" for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input class="quantity-input" id="Quantity-{{ section.id }}" type="number" name="quantity" inputmode="numeric" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}"{% if current_variant.quantity_rule.max != null %} max="{{ current_variant.quantity_rule.max }}"{% endif %} value="{{ current_variant.quantity_rule.min | default: 1 }}">
      <button type="submit" name="add" class="btn btn-primary add-to-cart" data-add-to-cart data-add-label="{{ 'product.add' | t }}" data-sold-label="{{ 'product.sold_out' | t }}" data-unavailable-label="{{ 'product.unavailable' | t }}"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
    {% endform %}
    <p class="product-service">{{ 'product.shipping_notice' | t }}{% if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'product.shipping_policy' | t }}</a>{% endif %}{% if shop.refund_policy.body != blank %} · <a href="{{ shop.refund_policy.url }}">{{ 'product.refund_policy' | t }}</a>{% endif %}</p>
    {% if settings.shipping_policy_text != blank %}<details class="product-details"><summary>{{ 'product.delivery' | t }}</summary><div class="rte">{{ settings.shipping_policy_text }}</div></details>{% endif %}
    {% if section.settings.size_guide != blank %}<details class="product-details" id="taglie"><summary>{{ 'product.size_guide' | t }}</summary><div class="rte">{{ section.settings.size_guide.content }}</div></details>{% endif %}
    {% if product.description != blank %}<details class="product-details" open><summary>{{ 'product.description' | t }}</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
    {% if section.settings.details != blank %}<details class="product-details"><summary>{{ section.settings.details_title | escape }}</summary><div class="rte">{{ section.settings.details }}</div></details>{% endif %}
    {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
  </div>
</div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Prodotto",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Mostra tipo prodotto",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostra acquisto rapido Shopify",
      "default": false
    },
    {
      "type": "page",
      "id": "size_guide",
      "label": "Pagina guida taglie"
    },
    {
      "type": "text",
      "id": "details_title",
      "label": "Titolo dettagli aggiuntivi",
      "default": "Cura del capo"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Dettagli aggiuntivi"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
