{% liquid
  assign desktop_video_url = 'hero-ricami.mp4' | asset_url
  assign mobile_video_url = 'hero-ricami-mobile.mp4' | asset_url
  assign desktop_poster_url = 'hero-ricami-poster.webp' | asset_url
  assign mobile_poster_url = 'hero-ricami-mobile-poster.webp' | asset_url
  assign desktop_sources = section.settings.desktop_video.sources | where: 'format', 'mp4' | sort: 'height'
  assign mobile_sources = section.settings.mobile_video.sources | where: 'format', 'mp4' | sort: 'height'
  assign desktop_source = desktop_sources | first
  assign mobile_source = mobile_sources | first
  for candidate in desktop_sources
    if candidate.height <= 1080
      assign desktop_source = candidate
    endif
  endfor
  for candidate in mobile_sources
    if candidate.height <= 1080
      assign mobile_source = candidate
    endif
  endfor
  if desktop_source != blank
    assign desktop_video_url = desktop_source.url
    assign mobile_video_url = desktop_source.url
    assign desktop_poster_url = section.settings.desktop_video.preview_image | image_url: width: 1920
    assign mobile_poster_url = desktop_poster_url
  endif
  if mobile_source != blank
    assign mobile_video_url = mobile_source.url
    assign mobile_poster_url = section.settings.mobile_video.preview_image | image_url: width: 1080
  endif
  if section.settings.desktop_poster != blank
    assign desktop_poster_url = section.settings.desktop_poster | image_url: width: 1920
  endif
  if section.settings.mobile_poster != blank
    assign mobile_poster_url = section.settings.mobile_poster | image_url: width: 1080
  endif
  assign collection_url = '#shop'
  if section.settings.collection != blank
    assign collection_url = section.settings.collection.url
  endif
%}
{{ 'embroidery-scene.css' | asset_url | stylesheet_tag }}
{{ 'embroidery-shopify.css' | asset_url | stylesheet_tag }}
<div data-embroidery-section data-pause-video="{{ 'embroidery.pause_video' | t | escape }}" data-pause-video-label="{{ 'embroidery.pause_video_label' | t | escape }}" data-play-video="{{ 'embroidery.play_video' | t | escape }}" data-play-video-label="{{ 'embroidery.play_video_label' | t | escape }}" data-retry-video="{{ 'embroidery.retry_video' | t | escape }}" data-video-unavailable="{{ 'embroidery.video_unavailable' | t | escape }}">
  <section class="embroidery-story" aria-labelledby="MotionTitle-{{ section.id }}" data-embroidery-story>
    <div class="embroidery-stage">
      <div class="embroidery-video-media" aria-hidden="true">
        <picture class="embroidery-video-poster" data-embroidery-poster><source media="(max-width: 600px)" srcset="{{ mobile_poster_url }}"><img src="{{ desktop_poster_url }}" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" loading="eager"></picture>
        <video id="EmbroideryHeroVideo-{{ section.id }}" class="embroidery-hero-video" data-embroidery-video data-src="{{ desktop_video_url }}" data-mobile-src="{{ mobile_video_url }}" data-poster="{{ desktop_poster_url }}" data-mobile-poster="{{ mobile_poster_url }}" poster="{{ desktop_poster_url }}" width="1920" height="1080" muted autoplay loop playsinline preload="none" tabindex="-1"></video>
      </div>
      <div class="motion-copy">
        <h1 id="MotionTitle-{{ section.id }}">{{ 'embroidery.heading' | t }}</h1>
        <p>{{ 'embroidery.description' | t }}</p>
        <div class="motion-actions"><a class="btn btn-light" href="{{ collection_url }}">{{ 'embroidery.shop_action' | t }} <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div>
      </div>
      <button class="embroidery-video-toggle" type="button" aria-controls="EmbroideryHeroVideo-{{ section.id }}" aria-label="{{ 'embroidery.play_video_label' | t | escape }}" data-embroidery-video-toggle hidden><span aria-hidden="true" data-embroidery-video-icon>▶</span><span data-embroidery-video-label>{{ 'embroidery.play_video' | t }}</span></button>
      <p class="embroidery-video-status" role="status" aria-live="polite" data-embroidery-video-status></p>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Video dei ricami",
  "tag": "div",
  "class": "embroidery-hero-section",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "paragraph", "content": "Il video incluso viene riprodotto senza audio. Puoi sostituirlo con video caricati nei File Shopify e scegliere copertine dedicate. La preferenza di movimento ridotto conserva la copertina fino alla riproduzione manuale." },
    { "type": "video", "id": "desktop_video", "label": "Video desktop" },
    { "type": "video", "id": "mobile_video", "label": "Video mobile", "info": "Se scegli solo un nuovo video desktop, verrà usato anche su mobile." },
    { "type": "image_picker", "id": "desktop_poster", "label": "Copertina desktop" },
    { "type": "image_picker", "id": "mobile_poster", "label": "Copertina mobile" },
    { "type": "collection", "id": "collection", "label": "Collezione del pulsante", "info": "Se non selezioni una collezione, il pulsante porta alla selezione nella home." }
  ],
  "presets": [{ "name": "Video dei ricami" }]
}
{% endschema %}
