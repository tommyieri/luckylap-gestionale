<section class="page-content section-pad"><p class="eyebrow">{{ shop.name | escape }}</p><h1>{{ 'password.title' | t }}</h1>{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}{% form 'storefront_password', class: 'contact-form' %}{{ form.errors | default_errors }}<label for="StorePassword">{{ 'password.label' | t }}</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required><button type="submit" class="btn btn-primary">{{ 'password.enter' | t }}</button>{% endform %}</section>
{% schema %}
{
  "name": "Negozio protetto",
  "settings": []
}
{% endschema %}
