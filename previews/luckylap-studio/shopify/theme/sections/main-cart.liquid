<section class="cart-page section-pad"><div class="section-heading"><h1>{{ 'cart.title' | t }}</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} <span aria-hidden="true">↗</span></a></div>{% if cart.item_count == 0 %}<div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">{{ 'navigation.shop' | t }}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line"><a class="cart-line-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag: widths: '160, 240, 400', sizes: '(min-width: 700px) 150px, 100px', loading: 'lazy', alt: item.product.title }}{% endif %}</a><div class="cart-line-info"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign property_first_character = property.first | slice: 0 %}{% if property.last != blank and property_first_character != '_' %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endif %}{% endfor %}{% for allocation in item.line_level_discount_allocations %}<p class="cart-discount">{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>{% endfor %}<a class="cart-remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}">{{ 'cart.remove' | t }}</a></div><div class="cart-line-quantity"><label for="Quantity-{{ item.index | plus: 1 }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max != null %} max="{{ item.variant.quantity_rule.max }}"{% endif %} value="{{ item.quantity }}" inputmode="numeric" aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}"></div><p class="cart-line-price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}{{ item.final_line_price | money }}</p></article>{% endfor %}</div><div class="cart-summary">{% if section.settings.show_note %}<label for="CartNote">{{ 'cart.note' | t }}</label><textarea name="note" id="CartNote" rows="3">{{ cart.note | escape }}</textarea>{% endif %}{% for discount in cart.cart_level_discount_applications %}<p class="cart-discount">{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p><p class="cart-checkout-notice">{{ 'cart.checkout_notice' | t }}{% if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'product.shipping_policy' | t }}</a>{% endif %}</p><button type="submit" name="update" class="btn btn-outline">{{ 'cart.update' | t }}</button><button type="submit" name="checkout" class="btn btn-primary">{{ 'cart.checkout' | t }} <span aria-hidden="true">↗</span></button>{% if section.settings.show_accelerated_checkout and additional_checkout_buttons %}<div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{% endif %}</div></form>{% endif %}</section>
{% schema %}
{
  "name": "Carrello",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Mostra nota ordine",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated_checkout",
      "label": "Mostra pagamenti rapidi Shopify",
      "default": false
    }
  ]
}
{% endschema %}
