<section class="knitwear" id="knitwear" aria-labelledby="KnitwearTitle-{{ section.id }}"><div><h2 id="KnitwearTitle-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'knitwear.title' | t }}{% endif %}</h2>{% if section.settings.image %}<div class="knitwear-media">{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 750, 1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}</div>{% endif %}</div><div class="knitwear-copy"><span class="coming-soon">{{ 'knitwear.soon' | t }}</span><div class="wool-truth">{{ 'knitwear.composition' | t }}<br>{{ 'knitwear.origin' | t }}</div><p>{% if section.settings.text != blank %}{{ section.settings.text | escape }}{% else %}{{ 'knitwear.text' | t }}{% endif %}</p>{% if section.settings.button_link != blank %}<a class="text-link" href="{{ section.settings.button_link }}">{% if section.settings.button_label != blank %}{{ section.settings.button_label | escape }}{% else %}{{ 'knitwear.action' | t }}{% endif %}<span aria-hidden="true">↗</span></a>{% endif %}</div></section>
{% schema %}
{
  "name": "Maglieria futura",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine reale maglieria"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo collegamento facoltativo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Collegamento facoltativo"
    }
  ],
  "presets": [
    {
      "name": "Maglieria futura"
    }
  ]
}
{% endschema %}
