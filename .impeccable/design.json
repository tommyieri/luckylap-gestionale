    },
    {
      "name": "Ricerca inventario",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Campo di ricerca con focus sul contenitore.",
      "html": "<label class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-field\" type=\"search\" aria-label=\"Cerca prodotto, SKU o colore\" placeholder=\"Cerca prodotto, SKU o colore…\"/></label>",
      "css": ".ds-search{font-family:Barlow,Arial,sans-serif;display:flex;align-items:center;gap:9px;border:1px solid var(--rule,#c9cfc3);border-radius:5px;padding:0 11px;min-height:38px;max-width:365px;color:var(--muted,#5a6257);background:var(--paper,#fff)}.ds-search-field{font-family:Barlow,Arial,sans-serif;width:100%;min-width:0;border:0;outline:none;background:transparent;font-size:12px;padding:9px 0;color:var(--ink,#121512);caret-color:var(--green,#1d4b07)}.ds-search-field::placeholder{color:#686f63;opacity:1}.ds-search:focus-within{border-color:#718c5a;outline:2px solid #cbdabb;outline-offset:1px}"
    },
    {
      "name": "Navigazione laterale",
      "kind": "nav",
      "refersTo": "navigation-item-active",
      "description": "Voce corrente chiara sulla superficie verde scuro.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Operatività\"><p class=\"ds-nav-label\">OPERATIVITÀ</p><button class=\"ds-nav-item ds-nav-selected\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"m21 8-9 5-9-5M12 13v9M3 7l9-5 9 5v10l-9 5-9-5Z\"/></svg>Magazzino</button><button class=\"ds-nav-item\">Packaging</button></nav>",
      "css": ".ds-nav{font-family:Barlow,Arial,sans-serif;width:204px;padding:16px 14px;background:var(--green-dark,#15370a);color:#d9e4d0}.ds-nav-label{font-size:9px;font-weight:600;letter-spacing:.1em;color:#b6c6a9;margin:0 0 8px;padding:0 13px}.ds-nav-item{font-family:Barlow,Arial,sans-serif;display:flex;align-items:center;gap:11px;width:100%;min-height:41px;padding:9px 12px;margin-top:3px;border:0;border-radius:5px;background:transparent;color:#d9e4d0;font-size:13px;text-align:left;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-nav-item:hover{background:#ffffff0c;color:#fff}.ds-nav-selected,.ds-nav-selected:hover{background:var(--green-wash,#e4ecdb);color:var(--green-dark,#15370a);font-weight:600}.ds-nav-item:focus-visible{outline:3px solid #82a35c;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
    {
      "name": "Stati di magazzino",
      "kind": "chip",
      "refersTo": "stock-status",
      "description": "Etichette testuali con punto colorato; non dipendono dal solo colore.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-status ds-available\"><span class=\"ds-status-dot\"></span>Disponibile</span><span class=\"ds-status ds-empty\"><span class=\"ds-status-dot\"></span>Esaurito</span><span class=\"ds-status ds-unknown\"><span class=\"ds-status-dot\"></span>Da verificare</span></div>",
      "css": ".ds-statuses{font-family:Barlow,Arial,sans-serif;display:flex;flex-wrap:wrap;gap:16px}.ds-status{display:inline-flex;align-items:center;gap:5px;font-size:10px;white-space:nowrap}.ds-status-dot{width:5px;height:5px;border-radius:50%;background:currentColor}.ds-available{color:var(--green,#1d4b07)}.ds-empty{color:var(--red,#9b3b25)}.ds-unknown{color:var(--amber,#875800)}"
    },
    {
      "name": "Pannello operativo",
      "kind": "card",
      "refersTo": "panel",
      "description": "Contenitore piatto con titolo, metadati e azione testuale.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2 class=\"ds-panel-title\">Attività</h2><span class=\"ds-panel-meta\">0 aperte</span></div><p class=\"ds-panel-empty\">La prima attività parte da qui.</p><button class=\"ds-panel-action\">Apri attività</button></section>",
      "css": ".ds-panel{font-family:Barlow,Arial,sans-serif;max-width:440px;background:var(--paper,#fff);color:var(--ink,#121512);border:1px solid var(--rule,#c9cfc3);border-radius:var(--radius,8px);padding:23px}.ds-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.ds-panel-title{margin:0;font-size:16px;font-weight:600;letter-spacing:-.01em}.ds-panel-meta{font-size:10px;color:var(--muted,#5a6257)}.ds-panel-empty{margin:0;padding:18px 0;color:var(--muted,#5a6257);font-size:12px}.ds-panel-action{font-family:Barlow,Arial,sans-serif;padding:3px 0;border:0;background:transparent;color:var(--green,#1d4b07);font-size:12px;font-weight:500;cursor:pointer}.ds-panel-action:hover{text-decoration:underline;text-underline-offset:3px}.ds-panel-action:focus-visible{outline:3px solid #82a35c;outline-offset:3px;}"
    },
    {
      "name": "Riga inventario",
      "kind": "custom",
      "refersTo": "inventory-row",
      "description": "Nome e SKU su due livelli, taglia centrale e quantità a destra.",
      "html": "<table class=\"ds-inventory\"><thead><tr><th>Prodotto / SKU</th><th class=\"ds-size\">Taglia</th><th class=\"ds-numeric\">Centrale</th></tr></thead><tbody><tr class=\"ds-product-row\"><td><button class=\"ds-product-name\"><strong class=\"ds-product-model\">GT3RS</strong><span class=\"ds-product-sku\">LL-TS-GT3-NB-XS</span></button></td><td class=\"ds-size\"><span class=\"ds-size-tag\">XS</span></td><td class=\"ds-numeric ds-quantity\">2</td></tr></tbody></table>",
      "css": ".ds-inventory{font-family:Barlow,Arial,sans-serif;width:100%;max-width:620px;border-collapse:collapse;background:var(--paper,#fff);color:var(--ink,#121512);font-size:12px;text-align:left}.ds-inventory th{font-size:10px;font-weight:500;background:#f1f4ed;color:#515c46;padding:12px 17px;border-top:1px solid #dce2d5;border-bottom:1px solid #dce2d5}.ds-product-row td{padding:11px 17px;border-bottom:1px solid #e7ebe2;line-height:1.4}.ds-product-row:hover{background:#f5f8f0}.ds-product-row:focus-within{background:#f0f5e9}.ds-product-name{font-family:Barlow,Arial,sans-serif;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.ds-product-name:focus-visible{outline:3px solid #82a35c;outline-offset:3px;}.ds-product-model{display:block;font-size:12px;font-weight:500}.ds-product-sku{display:block;margin-top:3px;font-size:9px;color:#66705d;letter-spacing:.025em}.ds-inventory .ds-size{text-align:center}.ds-size-tag{display:inline-flex;align-items:center;justify-content:center;min-width:27px;padding:2px 5px;border:1px solid #dde2d6;border-radius:3px;background:#fbfcfa;color:#4e5846;font-size:10px}.ds-inventory .ds-numeric{text-align:right;font-variant-numeric:tabular-nums}.ds-quantity{font-weight:500}"
    },
